#!/usr/bin/env python3
"""\
Tool for getting variables and includes from makefiles.

Mostly specialized for turnkey usage (cuts corners that might cause issues in
broader applications)
"""

import json
import sys
from argparse import ArgumentParser, RawTextHelpFormatter
from os.path import abspath


def fatal(msg):
    print(f"Fatal: {msg}", file=sys.stderr)
    sys.exit(1)


try:
    from libtkldet import mkparser
except ImportError:
    fatal("tkldev-detective not installed (required for makefile parser)")
    

def main() -> None:
    parser = ArgumentParser(
        description=__doc__, formatter_class=RawTextHelpFormatter,
    )
    parser.add_argument("makefile", metavar="path/to/Makefile")

    selection_group = parser.add_mutually_exclusive_group()
    selection_group.add_argument(
        "-a", "--all", action="store_true", help="(default) show everything",
    )
    selection_group.add_argument(
        "-v",
        "--var",
        nargs="?",
        metavar="VARNAME",
        const=True,
        help="show all variables or specific variable if specified",
    )
    selection_group.add_argument(
        "-i", "--included", action="store_true", help="show all included",
    )
    selection_group.add_argument(
        "-c",
        "--common-makefiles",
        action="store_true",
        help="show included common makefiles only",
    )

    format_group = parser.add_mutually_exclusive_group()

    format_group.add_argument(
        "-s", "--shell", help="output in a shell friendly way",
    )
    format_group.add_argument("-j", "--json", help="output json")

    parser.add_argument(
        "-d",
        "--shell-delim",
        default=":",
        help="delimiter to use with shell output",
    )

    args = parser.parse_args()

    
    if args.json:
        def dump(v, prefix=None):
            return json.dumps(v, indent=4)
    else:
        def dump(v, prefix=None):
            no_prefix = prefix is None
            if no_prefix:
                prefix = []
            out = []
            if isinstance(v, dict):
                for k, vs in v.items():
                    out.extend(dump(vs, [*prefix, k]))
            elif isinstance(v, list):
                for v in v:
                    out.extend(dump(v, prefix))
            elif isinstance(v, str):
                out.append(args.shell_delim.join([*prefix, v]))
            else:
                raise TypeError(
                    "don't know how to format {type(v)} in a shell friendly"
                    " way",
                )
            if no_prefix:
                return '\n'.join(out)
            else:
                return out
    try:
        data = mkparser.parse_makefile(abspath(args.makefile)).to_dict()
    except FileNotFoundError:
        fatal(
            "Makefile not found - please ensure that you are in app build code"
            " base dir",
        )

    if args.var:
        if isinstance(args.var, str):
            if args.var in data["variables"]:
                print(dump(data["variables"][args.var]))
            else:
                print("variable not found", file=sys.stderr)
        else:
            print(dump(data["variables"]))
    elif args.included:
        print(dump(data["included"]))
    elif args.common_makefiles:
        common_makefiles = []
        for makefile in data["included"]:
            if (
                    makefile.startswith("/tmp")
                    or makefile.endswith("/Makefile")
                    or makefile.endswith("/product.mk")
            ):
                continue
            common_makefiles.append(makefile)
        print(dump(common_makefiles))
    else:
        print(dump(data))


if __name__ == "__main__":
    main()
